generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// PDF enviado pelo usuário e transformado em simulado
model Document {
  id          String   @id @default(cuid())
  title       String
  fileName    String
  fileSize    Int      @default(0)
  pages       Int      @default(0)
  charCount   Int      @default(0)
  // multipla | certo_errado
  style       String   @default("multipla")
  // processing | ready | error
  status      String   @default("processing")
  error       String?
  chunks      Json?
  chunksTotal Int      @default(0)
  chunksDone  Int      @default(0)
  createdAt   DateTime @default(now())

  questions  Question[]
  textBlocks TextBlock[]
  attempts   Attempt[]
}

// Questão gerada por IA a partir do conteúdo do PDF
model Question {
  number     Int      @id @default(autoincrement())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  topic      String   @default("Geral")
  statement  String
  options    String // JSON: [{ key, html }]
  answer     String // 'a'..'e'
  comment    String
  textRef    String?

  @@index([documentId])
}

// Bloco de texto de apoio (trecho do PDF usado por questões)
model TextBlock {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  refId      String
  title      String
  paragraphs String // JSON: string[]
  source     String?

  @@index([documentId])
}

// Tentativa finalizada de um simulado
model Attempt {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name       String   @default("")
  mode       String // prova | estudo
  correct    Int
  total      Int
  pct        Int
  timeUsedMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([documentId])
}
